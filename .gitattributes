# Set default behavior to automatically normalize line endings.
# eol=lf pins checkout to LF repository-wide so the behavior does not
# depend on each machine's core.eol/core.autocrlf config (P4h).
* text=auto eol=lf

# Enforce LF for all shell scripts and bash files across all OSes
*.sh text eol=lf

# Enforce CRLF for Windows batch files
*.bat text eol=crlf
*.cmd text eol=crlf
